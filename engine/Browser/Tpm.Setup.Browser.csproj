<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Paired with the unchanged runtime notices in notices/dotnet. -->
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAOTCompilation>true</RunAOTCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmSingleFileBundle>false</WasmSingleFileBundle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Tpm.Setup.Core.csproj" />
  </ItemGroup>
</Project>
